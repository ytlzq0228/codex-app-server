[Unit]
Description=Codex App Server Gateway
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/codex-app-server
ExecStart=/usr/bin/docker compose up -d --no-build db worker-1 worker-manager gateway
ExecReload=/usr/bin/docker compose up -d --no-build db worker-1 worker-manager gateway
ExecStop=/usr/bin/docker compose stop gateway worker-manager worker-1 db
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
