CODEX_GATEWAY_DATABASE_URL=postgresql+asyncpg://codex:codex@db:5432/codex_gateway
CODEX_GATEWAY_KEY_PEPPER=change-this-to-a-long-random-secret
CODEX_GATEWAY_ADMIN_PASSWORD=development-admin-change-me
CODEX_GATEWAY_ADMIN_USERNAME=admin
CODEX_GATEWAY_ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# Cookie Secure flag. Leave unset to detect HTTPS from the request; set true to
# force it on when the TLS proxy is not in CODEX_GATEWAY_TRUSTED_PROXY_IPS.
CODEX_GATEWAY_ADMIN_COOKIE_SECURE=true
CODEX_GATEWAY_AUTO_CREATE_SCHEMA=true
CODEX_GATEWAY_BACKEND=mock
# Leave empty outside development. Any value here is a full-access API credential.
CODEX_GATEWAY_DEV_API_KEY=
CODEX_GATEWAY_UPSTREAM_MODEL=gpt-6-sol
CODEX_GATEWAY_ALLOWED_MODELS=gpt-6-sol,gpt-6-astra,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.6
CODEX_GATEWAY_MODEL_ALIASES=gpt-5.6:gpt-5.6-sol
CODEX_GATEWAY_APP_SERVER_URL=ws://worker-1:4500
CODEX_GATEWAY_APP_SERVER_TOKEN=development-worker-token-change-me
CODEX_GATEWAY_APP_SERVER_TIMEOUT_SECONDS=300
CODEX_GATEWAY_APP_SERVER_MAX_MESSAGE_BYTES=67108864
CODEX_GATEWAY_WORKSPACE_HOST_ROOT=/worker-workspaces/worker-1
CODEX_GATEWAY_WORKSPACE_WORKER_ROOT=/workspace
CODEX_GATEWAY_MANAGER_URL=http://worker-manager:4600
CODEX_GATEWAY_MANAGER_TOKEN=change-this-manager-token
CODEX_MANAGER_TOKEN=change-this-manager-token
# Includes base64 image data and conversation history (20 MiB).
CODEX_GATEWAY_MAX_REQUEST_BYTES=20971520
CODEX_GATEWAY_WORKER_RECOVERY_INTERVAL_SECONDS=30
CODEX_GATEWAY_WORKER_FAILURE_COOLDOWN_SECONDS=300
CODEX_GATEWAY_WORKER_LIMIT_COOLDOWN_SECONDS=1800
# Ordinary execution bindings are retained; the active-session view covers 2 hours.
CODEX_GATEWAY_EXECUTION_RESUME_ENABLED=true
CODEX_GATEWAY_MAX_WORKERS_PER_USER=10
CODEX_GATEWAY_MAX_WS_PER_KEY_WORKER=10
CODEX_GATEWAY_MAX_WS_PER_WORKER=40
CODEX_GATEWAY_WS_IDLE_TTL_SECONDS=600
CODEX_GATEWAY_WS_ACQUIRE_TIMEOUT_SECONDS=30
CODEX_GATEWAY_WS_PING_TIMEOUT_SECONDS=300
CODEX_GATEWAY_DATABASE_POOL_SIZE=20
CODEX_GATEWAY_DATABASE_MAX_OVERFLOW=30
CODEX_GATEWAY_DATABASE_POOL_TIMEOUT_SECONDS=10
# Only these proxy peers may restore client IP/scheme from forwarded headers.
CODEX_GATEWAY_TRUSTED_PROXY_IPS=192.0.2.8,192.0.2.9,203.0.113.8,203.0.113.9
CODEX_WORKER_TOKEN=development-worker-token-change-me

# Optional Claude subscription workers (build worker/claude first).
CLAUDE_WORKER_IMAGE=codex-claude-worker:2.1.287
# Append Claude models to ALLOWED_MODELS and configure their provider explicitly:
# CODEX_GATEWAY_MODEL_PROVIDERS=claude-sonnet-5-5:claude,claude-opus-5-5:claude,claude-haiku-4-5:claude
CODEX_GATEWAY_CLAUDE_NATIVE_MODEL_ALIASES=

# Dual-active deployment (see deploy/compose.ha.yaml). Shared secrets must match.
CODEX_GATEWAY_NODE_ID=
CODEX_GATEWAY_NODE_GATEWAY_URL=
CODEX_GATEWAY_NODE_MANAGER_URL=
CODEX_GATEWAY_NODE_TIMEOUT_SECONDS=30
CODEX_GATEWAY_BOOTSTRAP_WORKER=true

# Bounded waiting for Claude automatic conversation continuation (per gateway process)
CODEX_GATEWAY_CLAUDE_EXECUTION_WAIT_SECONDS=5
CODEX_GATEWAY_CLAUDE_EXECUTION_MAX_WAITERS=8
