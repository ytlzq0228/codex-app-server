CODEX_GATEWAY_APP_SERVER_TOKEN=development-worker-token-change-me
CODEX_GATEWAY_APP_SERVER_TIMEOUT_SECONDS=300
CODEX_GATEWAY_WORKSPACE_HOST_ROOT=/worker-workspaces/worker-1
CODEX_GATEWAY_WORKSPACE_WORKER_ROOT=/workspace
CODEX_GATEWAY_MANAGER_URL=http://worker-manager:4600
CODEX_GATEWAY_MANAGER_TOKEN=change-this-manager-token
CODEX_MANAGER_TOKEN=change-this-manager-token
CODEX_GATEWAY_MAX_REQUEST_BYTES=1048576
CODEX_GATEWAY_WORKER_RECOVERY_INTERVAL_SECONDS=30
CODEX_GATEWAY_WORKER_FAILURE_COOLDOWN_SECONDS=300
CODEX_GATEWAY_WORKER_LIMIT_COOLDOWN_SECONDS=1800
CODEX_GATEWAY_RESPONSE_BINDING_TTL_HOURS=24
CODEX_GATEWAY_MAX_WS_PER_KEY_WORKER=10
CODEX_GATEWAY_MAX_WS_PER_WORKER=40
CODEX_GATEWAY_WS_IDLE_TTL_SECONDS=600
CODEX_GATEWAY_WS_ACQUIRE_TIMEOUT_SECONDS=30
CODEX_GATEWAY_DATABASE_POOL_SIZE=20
CODEX_GATEWAY_DATABASE_MAX_OVERFLOW=30
CODEX_GATEWAY_DATABASE_POOL_TIMEOUT_SECONDS=10
