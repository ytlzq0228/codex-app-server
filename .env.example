CODEX_GATEWAY_DEV_API_KEY=cag_dev_local
CODEX_GATEWAY_UPSTREAM_MODEL=gpt-6-sol
CODEX_GATEWAY_ALLOWED_MODELS=gpt-6-sol,gpt-6-astra,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.6
CODEX_GATEWAY_MODEL_ALIASES=gpt-5.6:gpt-5.6-sol
